# ----- STEP 1: INITIALIZATION & PREPROCESSING -----
def main():
    # 1.1 Read mesh from .gri file
    Mesh = read_mesh('coarse_blade_mesh.gri')
    #     - Node coordinates (V)
    #     - Element connectivity (E)
    #     - Boundary edge info (BE) with boundary group IDs
    #     - Interior edge info (IE) connecting element pairs
    
    # 1.2 Compute geometric quantities (do this ONCE, reuse throughout)
    Geometry = compute_geometry(Mesh)
    #     - Element areas (for each cell)
    #     - Interior edge normals and lengths (pointing from Left to Right element)
    #     - Boundary edge normals and lengths (pointing outward)
    
    # 1.3 Set flow parameters
    rho0 = 1.0        # Inlet stagnation density
    a0 = 1.0          # Inlet stagnation speed of sound
    p0 = rho0*a0^2/γ  # Inlet stagnation pressure
    alpha = 50°       # Inlet angle of attack
    pout = 0.7*p0     # Outflow static pressure
    gamma = 1.4       # Ratio of specific heats
    
    # 1.4 Initialize solution
    U = initialize_state(Mesh, rho0, a0, alpha)
    #     U[i,:] = [rho, rho*u, rho*v, rho*E] for each element i
    #     Initial guess: uniform flow with Mach=0.1 at inlet conditions
    
    # 1.5 Time-stepping parameters
    CFL = 0.5         # CFL number for stability
    max_iter = 10000  # Maximum iterations
    tol = 1e-5        # Convergence tolerance (5 orders of magnitude)


# ----- STEP 2: MAIN TIME-STEPPING LOOP (STEADY STATE) -----
def solve_steady_state(Mesh, Geometry, U, parameters):
    
    R0 = None  # Initial residual norm for convergence check
    
    for iter in range(max_iter):
        
        # 2.1 Compute residual R (sum of fluxes for each cell)
        R, dt_local = compute_residual(Mesh, Geometry, U, parameters)
        #     R[i,:] = net flux OUT of cell i (4 equations per cell)
        #     dt_local[i] = local stable time step for cell i
        
        # 2.2 Check convergence
        R_norm = L1_norm(R)
        if iter == 0:
            R0 = R_norm
            print(f"Initial residual: {R0}")
        
        if iter % 10 == 0:
            print(f"Iter {iter}: Residual = {R_norm:.6e}, Ratio = {R_norm/R0:.6e}")
        
        if R_norm/R0 < tol:
            print("CONVERGED!")
            break
        
        # 2.3 Update solution using time integration
        U = time_step_SSP_RK2(U, R, dt_local, Geometry.areas)
        #     For steady state: use LOCAL time stepping (each cell has own dt)
        #     For unsteady: use GLOBAL time step (same dt for all cells)
    
    return U


# ----- STEP 3: RESIDUAL CALCULATION (THE CORE FV METHOD) -----
def compute_residual(Mesh, Geometry, U, parameters):
    
    # Initialize residual to zero
    R = zeros(num_elements, 4)
    dt_local = zeros(num_elements)  # For CFL time step
    
    # 3.1 Loop over INTERIOR EDGES (between two cells)
    for each interior edge (eL, eR):  # eL = left elem, eR = right elem
        
        # Get states on left and right
        UL = U[eL, :]
        UR = U[eR, :]
        
        # Get edge normal (pointing L→R) and length
        n = Geometry.interior_normals[edge]
        length = Geometry.interior_lengths[edge]
        
        # Compute numerical flux using Riemann solver
        F, smag = riemann_solver(UL, UR, n, gamma)
        #     F = flux vector [4x1]
        #     smag = maximum wave speed (for CFL)
        
        # Add flux contribution to residuals
        R[eL, :] += F * length   # Flux OUT of left cell
        R[eR, :] -= F * length   # Flux IN to right cell (opposite sign)
        
        # Accumulate wave speeds for time step
        dt_local[eL] += smag * length
        dt_local[eR] += smag * length
    
    # 3.2 Loop over BOUNDARY EDGES
    for each boundary edge:
        
        eL = element adjacent to boundary
        UL = U[eL, :]
        n = Geometry.boundary_normals[edge]
        length = Geometry.boundary_lengths[edge]
        boundary_type = identify_boundary_type(edge)
        
        # Apply boundary condition to get flux
        if boundary_type == "wall":
            F, smag = wall_flux(UL, n, gamma)
            #     Wall: no mass flux, only pressure force
            
        elif boundary_type == "subsonic_inflow":
            # Specify: stagnation pressure, stagnation density, flow angle
            # Compute: back pressure from interior
            F, smag = subsonic_inflow_flux(UL, n, p0, rho0, alpha, gamma)
            
        elif boundary_type == "subsonic_outflow":
            # Specify: static pressure pout
            # Extrapolate: other quantities from interior
            F, smag = subsonic_outflow_flux(UL, n, pout, gamma)
        
        # Add boundary flux contribution
        R[eL, :] += F * length
        dt_local[eL] += smag * length
    
    # 3.3 Convert wave speed sum to time step using CFL
    for i in range(num_elements):
        area = Geometry.areas[i]
        dt_local[i] = CFL * area / dt_local[i]
    
    return R, dt_local


# ----- STEP 4: SECOND-ORDER RECONSTRUCTION -----
def compute_residual_second_order(Mesh, Geometry, U, parameters):
    
    # 4.1 Compute gradients at each cell center
    gradU = compute_gradients(Mesh, Geometry, U)
    #     gradU[i, :, :] = [∂U/∂x, ∂U/∂y] for cell i
    #     Methods: Green-Gauss, least squares, etc.
    
    # 4.2 Apply limiter (optional but recommended)
    phi = compute_limiter(Mesh, Geometry, U, gradU)
    #     phi[i] = limiter coefficient for cell i (0 to 1)
    #     Methods: Barth-Jespersen, Venkatakrishnan, etc.
    
    # 4.3 Reconstruct states at edges
    R = zeros(num_elements, 4)
    dt_local = zeros(num_elements)
    
    for each interior edge (eL, eR):
        
        # Get cell centers
        xL = cell_center[eL]
        xR = cell_center[eR]
        
        # Get edge midpoint
        x_edge = edge_midpoint[edge]
        
        # Reconstruct left and right states at edge
        dx_L = x_edge - xL
        dx_R = x_edge - xR
        UL_edge = U[eL] + phi[eL] * (gradU[eL] · dx_L)
        UR_edge = U[eR] + phi[eR] * (gradU[eR] · dx_R)
        
        # Compute flux with reconstructed states
        n = Geometry.interior_normals[edge]
        length = Geometry.interior_lengths[edge]
        F, smag = riemann_solver(UL_edge, UR_edge, n, gamma)
        
        # Add to residual (same as first order)
        R[eL, :] += F * length
        R[eR, :] -= F * length
        dt_local[eL] += smag * length
        dt_local[eR] += smag * length
    
    # ... similar for boundary edges ...
    
    return R, dt_local


# ----- STEP 5: RIEMANN SOLVERS -----
def roe_flux(UL, UR, n, gamma):
    # 5.1 Compute primitive variables
    rhoL, uL, vL, pL = conservatives_to_primitives(UL, gamma)
    rhoR, uR, vR, pR = conservatives_to_primitives(UR, gamma)
    
    # 5.2 Compute Roe-averaged quantities
    rho_roe = sqrt(rhoL * rhoR)
    u_roe = (sqrt(rhoL)*uL + sqrt(rhoR)*uR) / (sqrt(rhoL) + sqrt(rhoR))
    # ... similar for v_roe, H_roe ...
    
    # 5.3 Eigenvalues and eigenvectors in normal direction
    un_roe = u_roe*n[0] + v_roe*n[1]
    c_roe = sqrt((gamma-1)*(H_roe - 0.5*(u_roe^2 + v_roe^2)))
    lambda = [un_roe - c_roe, un_roe, un_roe, un_roe + c_roe]
    
    # 5.4 Entropy fix for sonic points
    for i in range(4):
        if abs(lambda[i]) < epsilon * c_roe:
            lambda[i] = (lambda[i]^2 + (epsilon*c_roe)^2) / (2*epsilon*c_roe)
    
    # 5.5 Compute flux
    FL = compute_euler_flux(UL, n, gamma)
    FR = compute_euler_flux(UR, n, gamma)
    F = 0.5 * (FL + FR) - 0.5 * sum(|lambda[i]| * r[i] * delta_w[i])
    #     where r[i] = eigenvectors, delta_w = wave strengths
    
    smag = max(abs(lambda))  # Max wave speed for CFL
    return F, smag

