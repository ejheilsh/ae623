# ----- STEP 6: TIME INTEGRATION -----
def time_step_SSP_RK2(U, R, dt, areas):
    # Strong Stability Preserving Runge-Kutta 2nd order
    
    # Stage 1
    U1 = U.copy()
    for i in range(num_elements):
        U1[i, :] = U[i, :] - (dt[i] / areas[i]) * R[i, :]
    
    # Stage 2: compute residual at U1
    R1, _ = compute_residual(..., U1, ...)
    
    U_new = U.copy()
    for i in range(num_elements):
        U_new[i, :] = 0.5*U[i, :] + 0.5*U1[i, :] - 0.5*(dt[i]/areas[i])*R1[i, :]
    
    return U_new


# ----- STEP 7: POST-PROCESSING -----
def post_process(Mesh, U, parameters):
    
    # 7.1 Extract blade surface pressure coefficient
    cp_upper, cp_lower, x_coords = compute_cp_distribution(Mesh, U, pout, gamma)
    
    # 7.2 Compute force coefficients
    Fx, Fy = integrate_surface_forces(Mesh, U, gamma)
    cx = Fx / (qout * chord_length)
    cy = Fy / (qout * chord_length)
    
    # 7.3 Compute full-field quantities
    mach_field = compute_mach_number(U, gamma)
    entropy_field = compute_entropy(U, gamma)
    
    # 7.4 Plot results
    plot_contour(Mesh, mach_field, "Mach Number")
    plot_contour(Mesh, entropy_field, "Entropy")
    plot_cp_distribution(x_coords, cp_upper, cp_lower)
    
    return cx, cy