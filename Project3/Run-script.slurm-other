#!/bin/bash
#SBATCH --job-name=ae623_p3
#SBATCH --account=aerosp623w26_class
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --mem=4G
#SBATCH --time=08:00:00
#SBATCH --output=%x-%j.out

set -e

cd $HOME/repos/ae623/Project3
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# ./euler_solver grids/2k_q3.gri 0 1 roe 50000000 steady > log.run 2>&1
./euler_solver grids/32k_q3.gri 3 1 roe 50000000 steady  > log3.run 2>&1
